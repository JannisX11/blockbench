{
	"entryPointStrategy": "expand",
	"entryPoints": [
		"types/custom",
		"types/generated",
	],
	"exclude": [
		"types/generated/global_types.d.ts",
		"types/custom/uveditor.d.ts"
	],
	"plugin": [
		"typedoc-plugin-missing-exports"
	],
	"externalSymbolLinkMappings": {
		"typescript": {
			"Animation": "https://developer.mozilla.org/en-US/docs/Web/API/Animation",
			"Keyframe": "https://developer.mozilla.org/en-US/docs/Web/API/KeyframeEffect"
		}
	},
	"groupOrder": ["Classes", "*", "Modules"],
	"readme": "types/documentation.md",
	"excludeExternals": true,
	"internalModule": "Internal Types",
	"name": "Blockbench Reference Docs",
	"defaultCategory": "custom",
	"tsconfig": "types/tsconfig.json",
	"favicon": "./favicon.png",
	"customCss": "typedoc.css"
}